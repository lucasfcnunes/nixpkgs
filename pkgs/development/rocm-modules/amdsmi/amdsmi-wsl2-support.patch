+
+TEST(amdsmitstReadOnly, WslUuidIsStableAndDistinctByBdf) {
+  amd::smi::WslGpuInfo first;
+  first.device_id = 0x1586;
+  first.bdf.bdf.domain_number = 0;
+  first.bdf.bdf.bus_number = 0xc3;
